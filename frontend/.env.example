# Backend origin (no trailing slash). Required for production builds; optional in local dev.
#
# If you omit VITE_API_BASE during `npm run dev`, the API origin is inferred:
# - `app.<domain>` over HTTPS → `https://api.<domain>` (Path C; see src/api/baseUrl.ts).
# - Otherwise same hostname + port 8000 (localhost / LAN IP).
# Set VITE_API_BASE when the API is not on `api.<same domain>` (tunnel, custom host, etc.).
# VITE_API_BASE=http://localhost:8000
# VITE_API_BASE=https://api.example.com
#
# Optional — Vite dev behind HTTPS nginx (Path C). Not VITE_*; merged via loadEnv() in vite.config.ts.
# Host header must be allowed or Vite shows "Blocked request… allowedHosts":
# DEV_ALLOWED_HOSTS=app.example.com
# Same hostname also enables wss HMR when set here:
# DEV_HMR_HOST=app.example.com
# DEV_ALLOW_ANY_HOST=true
#
# Path C — API on https://api.<same-domain> (set at build time for production; optional in dev):
# VITE_API_BASE=https://api.example.com
#
# Runtime Audio File Input upload cap, in bytes. Keep aligned with backend STT_MAX_AUDIO_UPLOAD_BYTES,
# services/stt-bridge STT_MAX_AUDIO_BYTES, and nginx client_max_body_size.
# Default: 78643200 (75 MiB).
# VITE_STT_MAX_AUDIO_UPLOAD_BYTES=78643200
#
# Hide Build → Workspace in the shell when false (backend may still expose APIs if WORKSPACE_ENABLED is true).
# VITE_WORKSPACE_ENABLED=false
