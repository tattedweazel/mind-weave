{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-weave.dev/schemas/sandbox_canonical.schema.json",
  "title": "Mind Weave Sandbox V2",
  "schema_version": "2.4.0",
  "$defs": {
    "GridCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "Facing": {
      "type": "string",
      "enum": ["N", "E", "S", "W"]
    },
    "DecisionAction": {
      "type": "string",
      "enum": [
        "move_forward",
        "turn_left",
        "turn_right",
        "idle",
        "pick_up_item",
        "place_item"
      ]
    },
    "PlaceItemFilterType": {
      "type": "string",
      "enum": ["ball", "food"]
    },
    "NearbyCellKind": {
      "type": "string",
      "enum": ["empty", "wall", "food", "ball", "creature", "out_of_bounds"]
    },
    "NearbyCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "kind"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "kind": { "$ref": "#/$defs/NearbyCellKind" },
        "region_label": {
          "anyOf": [{ "type": "string" }, { "type": "null" }]
        }
      }
    },
    "ItemType": {
      "type": "string",
      "enum": ["food", "wall", "region", "ball"]
    },
    "PlaceableItemType": {
      "type": "string",
      "enum": ["food", "wall", "ball"]
    },
    "InventoryItemType": {
      "type": "string",
      "enum": ["ball", "food"]
    },
    "InventoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "$ref": "#/$defs/InventoryItemType" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "energy": { "type": "integer", "minimum": 0 }
      }
    },
    "RegionTriggerMode": {
      "type": "string",
      "enum": ["enter", "exit", "while_inside", "on_enter_once"]
    },
    "RegionTriggerConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "workflow_id", "inputs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "anyOf": [{ "$ref": "#/$defs/RegionTriggerMode" }, { "type": "null" }]
        },
        "workflow_id": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "inputs": { "type": "object" }
      }
    },
    "SandboxItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/ItemType" },
        "position": { "$ref": "#/$defs/GridCell" },
        "energy": { "type": "integer", "minimum": 0 },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "label": { "type": "string" },
        "trigger": { "$ref": "#/$defs/RegionTriggerConfig" }
      }
    },
    "CreatureState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflow_id", "position", "facing"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "position": { "$ref": "#/$defs/GridCell" },
        "facing": { "$ref": "#/$defs/Facing" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "inventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/InventoryItem" }
        }
      }
    },
    "WorldGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "WorldState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "items"],
      "properties": {
        "grid": { "$ref": "#/$defs/WorldGrid" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/SandboxItem" } }
      }
    },
    "RecentAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "action", "reason"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "creature_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "action": { "$ref": "#/$defs/DecisionAction" },
        "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "SandboxState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "creatures", "world", "recent_actions"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "creatures": { "type": "array", "items": { "$ref": "#/$defs/CreatureState" } },
        "world": { "$ref": "#/$defs/WorldState" },
        "recent_actions": { "type": "array", "items": { "$ref": "#/$defs/RecentAction" }, "maxItems": 10 }
      }
    },
    "SandboxTickInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "creature", "creatures", "world", "recent_actions"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "creature": { "$ref": "#/$defs/CreatureState" },
        "creatures": { "type": "array", "items": { "$ref": "#/$defs/CreatureState" } },
        "world": { "$ref": "#/$defs/WorldState" },
        "recent_actions": { "type": "array", "items": { "$ref": "#/$defs/RecentAction" }, "maxItems": 10 }
      }
    },
    "BoardCreaturePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workflow_id", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "name": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "position": { "$ref": "#/$defs/GridCell" },
        "facing": { "$ref": "#/$defs/Facing" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "inventory": {
          "type": "array",
          "items": { "$ref": "#/$defs/InventoryItem" }
        }
      }
    },
    "BoardDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "items", "creatures"],
      "properties": {
        "schema_version": { "type": "string" },
        "grid": { "$ref": "#/$defs/WorldGrid" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/SandboxItem" } },
        "creatures": { "type": "array", "items": { "$ref": "#/$defs/BoardCreaturePlacement" } }
      }
    },
    "DecisionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "$ref": "#/$defs/DecisionAction" },
        "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "item_type": {
          "anyOf": [{ "$ref": "#/$defs/PlaceItemFilterType" }, { "type": "null" }]
        },
        "inventory_index": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      }
    },
    "SandboxInteractionEvent": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "cell", "item_type"],
          "properties": {
            "type": { "const": "place_item" },
            "cell": { "$ref": "#/$defs/GridCell" },
            "item_type": { "$ref": "#/$defs/PlaceableItemType" },
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "cell"],
          "properties": {
            "type": { "const": "remove_item" },
            "cell": { "$ref": "#/$defs/GridCell" }
          }
        },
        {
          "type": "object",
          "required": ["type", "cell", "workflow_id", "color"],
          "properties": {
            "type": { "const": "place_creature" },
            "cell": { "$ref": "#/$defs/GridCell" },
            "workflow_id": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "facing": { "$ref": "#/$defs/Facing" },
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        },
        {
          "type": "object",
          "required": ["type", "cell"],
          "properties": {
            "type": { "const": "remove_creature" },
            "cell": { "$ref": "#/$defs/GridCell" }
          }
        },
        {
          "type": "object",
          "required": ["type", "cell", "color"],
          "properties": {
            "type": { "const": "place_region" },
            "cell": { "$ref": "#/$defs/GridCell" },
            "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "label": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["type", "cell"],
          "properties": {
            "type": { "const": "remove_region" },
            "cell": { "$ref": "#/$defs/GridCell" }
          }
        }
      ]
    }
  }
}
