{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mind-weave.dev/schemas/sandbox_canonical.schema.json",
  "title": "Mind Weave Sandbox V1",
  "schema_version": "1.0.0",
  "$defs": {
    "GridCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "DecisionAction": {
      "type": "string",
      "enum": ["move_to", "wander", "eat_nearby", "sleep", "idle"]
    },
    "IntentStatus": {
      "type": "string",
      "enum": ["in_progress", "complete", "failed"]
    },
    "ItemType": {
      "type": "string",
      "enum": ["food"]
    },
    "SandboxItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "position"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/ItemType" },
        "position": { "$ref": "#/$defs/GridCell" },
        "energy": {
          "type": "integer",
          "minimum": 0,
          "description": "Used by food in V1. Item is removed when energy reaches 0."
        }
      }
    },
    "DecisionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target_item_id", "target_cell", "reason"],
      "properties": {
        "action": { "$ref": "#/$defs/DecisionAction" },
        "target_item_id": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "target_cell": {
          "anyOf": [{ "$ref": "#/$defs/GridCell" }, { "type": "null" }]
        },
        "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "PetIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status",
        "target_item_id",
        "target_cell",
        "reason",
        "retry_count"
      ],
      "properties": {
        "action": { "$ref": "#/$defs/DecisionAction" },
        "status": { "$ref": "#/$defs/IntentStatus" },
        "target_item_id": {
          "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "target_cell": {
          "anyOf": [{ "$ref": "#/$defs/GridCell" }, { "type": "null" }]
        },
        "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "PetState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hunger", "energy", "mood", "position", "intent"],
      "properties": {
        "hunger": { "type": "integer", "minimum": 0, "maximum": 100 },
        "energy": { "type": "integer", "minimum": 0, "maximum": 100 },
        "mood": { "type": "integer", "minimum": 0, "maximum": 100 },
        "position": { "$ref": "#/$defs/GridCell" },
        "intent": {
          "anyOf": [{ "$ref": "#/$defs/PetIntent" }, { "type": "null" }]
        }
      }
    },
    "WorldGrid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "WorldState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "items"],
      "properties": {
        "grid": { "$ref": "#/$defs/WorldGrid" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/SandboxItem" }
        }
      }
    },
    "RecentAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "action", "reason"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/$defs/DecisionAction" },
        "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    },
    "SandboxState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "pet", "world", "recent_actions"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "pet": { "$ref": "#/$defs/PetState" },
        "world": { "$ref": "#/$defs/WorldState" },
        "recent_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/RecentAction" },
          "maxItems": 10
        }
      }
    },
    "SandboxTickInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tick", "pet", "world", "recent_actions"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "pet": { "$ref": "#/$defs/PetState" },
        "world": { "$ref": "#/$defs/WorldState" },
        "recent_actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/RecentAction" },
          "maxItems": 10
        }
      }
    },
    "SandboxInteractionEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cell"],
          "properties": {
            "type": { "const": "cell_click" },
            "cell": { "$ref": "#/$defs/GridCell" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "item_id"],
          "properties": {
            "type": { "const": "item_click" },
            "item_id": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cell", "item_type"],
          "properties": {
            "type": { "const": "place_item" },
            "cell": { "$ref": "#/$defs/GridCell" },
            "item_type": { "$ref": "#/$defs/ItemType" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cell"],
          "properties": {
            "type": { "const": "remove_item" },
            "cell": { "$ref": "#/$defs/GridCell" }
          }
        }
      ]
    }
  }
}
