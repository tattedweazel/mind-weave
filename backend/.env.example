# Database
DATABASE_URL=sqlite:///./mindweave.db

# Environment: use `local` for development. For staging/production, set a strong SECRET_KEY (32+ chars).
APP_ENV=local

# JWT / cookies — required. For local dev, min 16 characters. For production, min 32 and NEVER use the placeholder.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-for-dev-only-change-in-prod

# Short-lived access token (minutes) and refresh cookie lifetime (days).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# When false, POST /auth/register returns 403 (recommended for public deployments).
OPEN_REGISTRATION=true

# Optional: if true and APP_ENV=local and DB has no users, creates admin/admin once. Prefer: python -m app.cli create-admin
BOOTSTRAP_DEFAULT_ADMIN=false

# CORS — JSON list in .env, e.g. ["http://localhost:5173"]
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Trusted Host header (JSON list). Include your production API hostname(s) for Path C.
# TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# Set true only when the API is served only over HTTPS (adds HSTS).
SECURITY_ENABLE_HSTS=false

# When true, trust X-Forwarded-* from nginx on 127.0.0.1 (Path C — docs/DEPLOYMENT_AND_NETWORK.md).
# BEHIND_REVERSE_PROXY=false

# --- Path C (HTTPS + app.<domain> / api.<domain>) — copy into .env and replace hostnames ---
# CORS_ORIGINS=["https://app.example.com","http://localhost:5173","http://127.0.0.1:5173"]
# TRUSTED_HOSTS=["localhost","127.0.0.1","testserver","api.example.com"]
# BEHIND_REVERSE_PROXY=true
# FRONTEND_URL=https://app.example.com
# GOOGLE_REDIRECT_URI=https://api.example.com/api/v1/auth/google/callback
# GOOGLE_WORKFLOW_REDIRECT_URI=https://api.example.com/api/v1/google-workflow/oauth/callback

# Google OAuth (for account association)
# Create OAuth 2.0 credentials in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Add authorized redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# LM Studio — SSRF note: keep this URL config-only (never user-controlled).
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_CHAT_TIMEOUT=1800.0
LMSTUDIO_API_KEY="Test-token"
# API token from LM Studio (Developer → Server). Required for GET /api/v1/models/ (shared model pickers).
# Chat/workflows still prefer per-user My Settings lmstudio_api_key when set; this is the fallback for those too.
# LMSTUDIO_API_KEY=

# Optional default chat model id (must match GET /v1/models). Leave unset to use the first listed model.
# Legacy placeholder "local-model" is ignored — a real id is resolved from LM Studio instead.
# LMSTUDIO_MODEL=google/gemma-2-9b-it
# Chat completions (Simple LLM Call); large local models may need the full window.
LMSTUDIO_CHAT_TIMEOUT=3600.0
# After native POST /api/v1/models/load, poll until loaded_instances (0 = disable). Chat also retries 500/503/etc.
# LMSTUDIO_MODEL_READY_MAX_WAIT_SECONDS=60.0

# Rate limits: only `N/minute` (e.g. 60/minute). Invalid strings prevent the app from starting.
# AUTH_LOGIN_RATE_LIMIT=30/minute
# AUTH_REGISTER_RATE_LIMIT=15/minute
# AUTH_REFRESH_RATE_LIMIT=60/minute
# AUTH_GOOGLE_SESSION_RATE_LIMIT=30/minute
# Throttle workflow execution per client IP (POST /run and /run_stream share one counter).
# WORKFLOW_RUN_RATE_LIMIT=60/minute

# Companion / Workspace chat runtime. When false, /api/v1/companion/* and /api/v1/workspaces/* return 404.
# WORKSPACE_ENABLED=true

# Speech-to-text uploads. Keep these aligned with frontend VITE_STT_MAX_AUDIO_UPLOAD_BYTES,
# services/stt-bridge STT_MAX_AUDIO_BYTES, and nginx client_max_body_size.
# Default app cap is 78643200 bytes (75 MiB).
# STT_MAX_AUDIO_UPLOAD_BYTES=78643200

# Speech transcription providers (provider-abstracted `transcribe_file` skill).
# Comma-free JSON list. Default in config is ["local_whisper","assemblyai"] (both show in the editor).
# local_whisper wraps the STT bridge; assemblyai is cloud STT (per-user key in My Settings → API Settings,
# or set ASSEMBLYAI_API_KEY below as deployment fallback). Override to local only:
# TRANSCRIPTION_PROVIDERS_ENABLED=["local_whisper"]
# Lifespan poller cadence (seconds). 0 disables the poller (jobs only advance on reattach).
# TRANSCRIPTION_JOB_POLL_INTERVAL=5.0

# Speech models for POST /v2/transcript (non-empty JSON list; e.g. Universal Speech Model slugs).
# Default in config is ["universal-3-pro"]. Use ["universal-2"] for the prior tier if needed.
# ASSEMBLYAI_SPEECH_MODELS=["universal-3-pro"]

# AssemblyAI (optional cloud transcription provider). Per-user keys saved in My Settings →
# API Settings take precedence; this env value is the deployment-wide fallback.
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
# ASSEMBLYAI_UPLOAD_TIMEOUT=300.0
# ASSEMBLYAI_REQUEST_TIMEOUT=60.0
# ASSEMBLYAI_POLL_INTERVAL=3.0
# ASSEMBLYAI_JOB_TIMEOUT=1800.0
